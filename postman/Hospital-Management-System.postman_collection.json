{
  "info": {
    "name": "Hospital Management System - JWT (Assignment 02)",
    "description": "Requests for the Secure RESTful Hospital Management API.\n\n1. Set the collection variable `studentNo` to your student number (e.g. PS/2022/123).\n2. Run '1. Auth' requests in order. Login requests save their token into a collection variable automatically.\n3. For Task 2, paste the token you modified on jwt.io into the `tamperedToken` collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "studentNo", "value": "PS/2022/XXX" },
    { "key": "patientToken", "value": "" },
    { "key": "tamperedToken", "value": "PASTE-THE-MODIFIED-TOKEN-FROM-JWT.IO-HERE" },
    { "key": "adminToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "appointmentTime", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A future date/time for booking appointments (3 days from now, 10:00)",
          "const d = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000);",
          "d.setUTCHours(10, 0, 0, 0);",
          "pm.collectionVariables.set('appointmentTime', d.toISOString().slice(0, 19));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Patient (student number)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentNo}}\",\n  \"password\": \"{{studentNo}}\",\n  \"fullName\": \"Test User\",\n  \"role\": \"PATIENT\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login Patient (Screenshot 01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('patientToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentNo}}\",\n  \"password\": \"{{studentNo}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('doctorToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dr.silva\",\n  \"password\": \"doctor123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me (current user)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Task 2 - Tampered JWT",
      "item": [
        {
          "name": "Step 4 - Register Nurse with modified token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tampered token is rejected with 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tamperedToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"username\": \"{{studentNo}}-N\",\n  \"password\": \"{{studentNo}}\",\n  \"role\": \"NURSE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Step 5 - View patient records with modified token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tampered token is rejected with 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tamperedToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Control - View patient records with the genuine patient token (403)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/patients"
          }
        },
        {
          "name": "Control - Register Nurse with a real ADMIN token (201)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Nurse\",\n  \"username\": \"{{studentNo}}-NURSE\",\n  \"password\": \"{{studentNo}}\",\n  \"role\": \"NURSE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        }
      ]
    },
    {
      "name": "3. Admin",
      "item": [
        {
          "name": "List all patients",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/patients"
          }
        },
        {
          "name": "Add a doctor",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"dr.gunawardena\",\n  \"password\": \"doctor123\",\n  \"fullName\": \"Dr. Chamari Gunawardena\",\n  \"specialization\": \"Dermatology\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/admin/doctors"
          }
        },
        {
          "name": "Hospital statistics",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/stats"
          }
        },
        {
          "name": "List all users",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create patient (staff)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kasun Perera\",\n  \"dateOfBirth\": \"1990-05-12\",\n  \"gender\": \"MALE\",\n  \"phone\": \"0771112223\",\n  \"email\": \"kasun@example.com\",\n  \"address\": \"10 Main Street, Colombo\",\n  \"bloodGroup\": \"AB+\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/patients"
          }
        }
      ]
    },
    {
      "name": "4. Doctor",
      "item": [
        {
          "name": "My appointments",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors/appointments"
          }
        },
        {
          "name": "Write medical record",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"appointmentId\": 1,\n  \"diagnosis\": \"Stable angina\",\n  \"prescription\": \"Aspirin 75mg daily\",\n  \"notes\": \"Review in 2 weeks\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/records"
          }
        },
        {
          "name": "Complete appointment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/appointments/1/status"
          }
        }
      ]
    },
    {
      "name": "5. Patient",
      "item": [
        {
          "name": "Available doctors",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/doctors"
          }
        },
        {
          "name": "Book appointment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": 2,\n  \"appointmentTime\": \"{{appointmentTime}}\",\n  \"reason\": \"General check-up\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/patients/appointments"
          }
        },
        {
          "name": "My appointments",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/patients/appointments"
          }
        },
        {
          "name": "My medical records",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/patients/records"
          }
        }
      ]
    }
  ]
}
